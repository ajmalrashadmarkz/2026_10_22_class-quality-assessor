# ==============================================================================
# Class Quality Assessor - Example Environment Configuration
# ==============================================================================

# LLM API Configuration
# Compatible with DeepSeek, OpenRouter, or OpenAI
LLM_API_KEY=your_api_key_here
LLM_MODEL=deepseek-chat
OPENAI_BASE_URL=https://api.deepseek.com

# Speech-to-Text Model (tiny, base, small, medium)
WHISPER_MODEL=small

# Optional: Hugging Face Token (enables speaker diarization if provided)
HF_TOKEN=
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# Media Processing Bounds
FRAME_INTERVAL_SEC=20
MAX_FRAMES=36
MAX_UPLOAD_MB=500

# Privacy Guard (Default: false)
# When false, speech is transcribed locally and video frames are never sent to cloud
SEND_FRAMES_TO_CLOUD=false
